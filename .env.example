# Copy this file to .env, then fill in MINERU_API_TOKEN.
#
#   cp .env.example .env
#
# Routine users only need this file plus CLI flags.

# 1) Main LLM backend
# Default uses your local Codex login instead of an OpenAI Platform API key.
# Run `codex login` once before using the pipeline.
MODEL_PROVIDER=openai-codex
OPENAI_CODEX_MODEL=gpt-5.5
# Codex backend endpoint. The default points at the ChatGPT-backed Codex
# service used by `codex login`; override only if you have a different
# Codex-compatible endpoint.
OPENAI_CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
# Disable the openai-agents SDK tracing exporter (which would otherwise try to
# POST traces to a tracing endpoint). Leave as-is unless you actively want to
# collect agent traces.
OPENAI_AGENTS_DISABLE_TRACING=1

# Optional visual-model overrides for figure and original-page checks.
# With no overrides, checks inherit the main model, which must accept images.
# Switching provider uses that provider's model and credentials.
# openai-codex uses Codex login and does not accept VLM_API_KEY.
# VLM_MODEL_PROVIDER=
# VLM_MODEL=
# VLM_BASE_URL=
# VLM_API_KEY=

# 2) PDF parsing
# Required. MinerU's cloud API is free to start with generous quota and avoids
# local CUDA/GPU/MinerU model setup.
MINERU_API_TOKEN=
# Override only if you point at a different MinerU-compatible API endpoint.
MINERU_BASE_URL=https://mineru.net/api/v4

# Local MinerU CLI fallback (used by the execution stage's prepare node when
# the parse-stage snapshot is unavailable). Leave unset for the cloud API
# default; only set these if you have the local `mineru` CLI installed.
# MINERU_LOCAL_BACKEND=pipeline
# MINERU_LOCAL_DEVICE=cpu
# MINERU_LOCAL_SOURCE=

# 3) Teaser figure
# V2 writes a local SVG and an optional image-authoring prompt.
# The following Gemini settings apply only to the legacy v1 teaser workflow.
GEMINI_API_KEY=

# Legacy v1: force prompt-only output even when GEMINI_API_KEY is set.
# TEASER_USE_GEMINI=false
# 4) Literature retrieval
#
# 4a) Semantic Scholar credentials (used with PAPER_SEARCH_PROVIDER=semantic_scholar)
# A key helps avoid rate limits. SEMANTIC_SCHOLAR_ENABLED controls the legacy
# v1 objective-positioning stage; v2 Literature uses PAPER_SEARCH_ENABLED below.
SEMANTIC_SCHOLAR_ENABLED=true
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_API_KEY=

# 4b) Literature paper search and reading
# Enabled by default for claim-driven and global related-work checks.
# PAPER_SEARCH_ENABLED=false disables retrieval and leaves that scope unresolved.
# Provider options:
#   arxiv             zero-key arXiv API search; default
#   semantic_scholar  Semantic Scholar Graph API; uses SEMANTIC_SCHOLAR_API_KEY
#   openalex          OpenAlex Works API; uses OPENALEX_API_KEY when configured
#   remote            advanced: compatible /pasa/search service
PAPER_SEARCH_ENABLED=true
PAPER_SEARCH_PROVIDER=arxiv
PAPER_SEARCH_BASE_URL=
PAPER_SEARCH_API_KEY=
PAPER_SEARCH_ENDPOINT=/pasa/search
PAPER_SEARCH_HEALTH_ENDPOINT=/health

# Leave PAPER_READ_BASE_URL empty to use the built-in arXiv PDF full-text
# fallback when read_paper is called. Configure this only if you run a stronger
# remote reader service.
PAPER_READ_BASE_URL=
PAPER_READ_API_KEY=
PAPER_READ_ENDPOINT=/read

# 5) OpenAlex (optional, fourth reference cross-check backend)
# RefCopilot skips its OpenAlex backend when OPENALEX_API_KEY is empty.
# With a key, it queries OpenAlex alongside arXiv / Semantic Scholar / OpenReview.
# This gate does not disable an explicit PAPER_SEARCH_PROVIDER=openalex selection.
OPENALEX_API_KEY=
OPENALEX_BASE_URL=https://api.openalex.org
# 6) Reference checking
# V2 L1 always calls RefCopilot for bibliography entries; install its dependencies
# with `pip install -e ".[refcheck]"`. --enable-refcheck is a compatibility flag.
# The following optional gates apply only to legacy v1 entry points.
# FACTREVIEW_ENABLE_REFCHECK=false
# FACTREVIEW_EXECUTION_ENABLE_REFCHECK=false

# 7) Execution Docker environment (optional)
# These are useful on machines where containers cannot reliably reach the
# default PyPI / PyTorch hosts. They only affect per-paper Docker image builds.
# EXECUTION_DOCKER_PIP_INDEX_URL=https://pypi.org/simple
# EXECUTION_DOCKER_PIP_EXTRA_INDEX_URL=
# EXECUTION_DOCKER_PIP_TRUSTED_HOST=
# EXECUTION_DOCKER_HTTP_PROXY=
# EXECUTION_DOCKER_HTTPS_PROXY=
# EXECUTION_DOCKER_NO_PROXY=
# EXECUTION_DOCKER_GPUS=all
# EXECUTION_DOCKER_SHM_SIZE=16g
# EXECUTION_DOCKER_IPC=host
